{
  "name": "CAR-REZERVATION-PROJECT",
  "dockerComposeFile": ["docker-compose.dev.yml"],
  "service": "web",
  "workspaceFolder": "/workspace",

  "overrideCommand": false,
  "remoteUser": "root",

  "runServices": ["db", "plantuml", "web", "cron"],

  "forwardPorts": [8000, 5432, 8080],
  "portsAttributes": {
    "8000": { "label": "Django (container)", "onAutoForward": "notify" },
    "5432": { "label": "Postgres (container)", "onAutoForward": "silent" },
    "8080": { "label": "PlantUML (container)", "onAutoForward": "silent" }
  },
  
  "postCreateCommand": "bash .devcontainer/postCreateCommand.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
