openapi: 3.0.3
info:
  title: Car Reservation API
  version: 0.1.0
  description: OpenAPI schema pro MVP
paths:
  /api/v1/health/:
    get:
      operationId: v1_health_retrieve
      description: MVP endpoint pro ověření, že schema generování funguje.
      tags:
      - v1
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/HealthResponse'
          description: ''
  /api/v1/reservations/:
    get:
      operationId: v1_reservations_list
      tags:
      - v1
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Reservation'
          description: ''
  /api/v1/reservations/{id}/:
    get:
      operationId: v1_reservations_retrieve
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - v1
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Reservation'
          description: ''
components:
  schemas:
    HealthResponse:
      type: object
      properties:
        status:
          type: string
      required:
      - status
    Reservation:
      type: object
      properties:
        id:
          type: integer
        note:
          type: string
      required:
      - id
